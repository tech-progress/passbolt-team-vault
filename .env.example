MARIADB_PASSWORD=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
MARIADB_ROOT_PASSWORD=REPLACE_WITH_INDEPENDENT_32_OR_MORE_RANDOM_CHARACTERS
SECURITY_SALT=REPLACE_WITH_64_OR_MORE_RANDOM_CHARACTERS_KEEP_STABLE
APP_FULL_BASE_URL=https://vault.example.com
PASSBOLT_KEY_EMAIL=security@example.com
PASSBOLT_KEY_NAME=Passbolt team vault
EMAIL_DEFAULT_FROM=vault@example.com
EMAIL_DEFAULT_FROM_NAME=Passbolt team vault
EMAIL_TRANSPORT_DEFAULT_HOST=REPLACE_WITH_REAL_SMTP_HOST
EMAIL_TRANSPORT_DEFAULT_PORT=587
EMAIL_TRANSPORT_DEFAULT_USERNAME=REPLACE_WITH_SMTP_USERNAME
EMAIL_TRANSPORT_DEFAULT_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_TRANSPORT_DEFAULT_TLS=true
TEMPLATE_MODE=production
PASSBOLT_SSL_FORCE=true
PASSBOLT_SECURITY_COOKIE_SECURE=true

# Required only when compiling the offline Railway graph. No default repository.
TEMPLATE_SOURCE_REPO=
TEMPLATE_SOURCE_BRANCH=
TEMPLATE_SOURCE_ROOT_DIR=
